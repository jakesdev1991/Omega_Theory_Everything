[Unit]
Description=Omega Nostr Client - sovereign publisher + mention bot
After=omega-nostr-relay.service
Wants=omega-nostr-relay.service

[Service]
Type=simple
EnvironmentFile=-/home/jake/.config/omega-nostr/keys/env.sh
Environment=NODE_EXTRA_CA_CERTS=/home/jake/.config/omega-nostr/tls/omega-ca-cert.pem
ExecStart=/usr/bin/node /home/jake/Omega_Theory_Everything/nostr-client/client-daemon.mjs
WorkingDirectory=/home/jake/Omega_Theory_Everything/nostr-client
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
