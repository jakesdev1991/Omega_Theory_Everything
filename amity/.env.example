# Copy to .env and fill locally. Never commit a populated operator file.
# This scaffold is testnet-only and does not issue a Taproot Asset by itself.

# Required: the Bitcoin network for this scaffold. Must remain testnet for now.
AMITY_NETWORK=testnet

# Required once an AMITY testnet Taproot Asset exists.
AMITY_ASSET_ID=
AMITY_UNIVERSE_URL=https://universe.example.testnet/amity

# Optional operator labels for receipts/runbooks.
AMITY_ASSET_NAME=AMITY Test Asset
AMITY_UNIT_NAME=AMITY

# Expected local infrastructure endpoints.
LITD_RPC_HOST=127.0.0.1:8443
TAPD_RPC_HOST=127.0.0.1:10029

# Strongly recommended once real testnet nodes are in use.
LITD_TLS_CERT_PATH=
LITD_MACAROON_PATH=
TAPD_TLS_CERT_PATH=
TAPD_MACAROON_PATH=
