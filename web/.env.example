# Omega web app — optional environment overrides.
# Copy to .env.local and fill in only what you need. Everything fails closed
# (with an explanatory error) when a rail is not configured.
#
# Every variable the app reads is listed here; src/lib/env-example.test.ts fails
# the suite if the code grows a read that this file does not document.

# --- $OMEGA EVM unlock rail (Sepolia pilot) ---
# OMEGA_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# OMEGA_NOVEL_GATE_ADDRESS=0x...
# OMEGA_TOKEN_ADDRESS=0x...
# OMEGA_SEPOLIA_MANIFEST_PATH=/absolute/path/to/evm/deployments/sepolia.json

# --- TWC Solana unlock rail (Devnet pilot) ---
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# TWC_MINT_ADDRESS=...
# TWC_DEVNET_MANIFEST_PATH=/absolute/path/to/solana/deployments/twc-devnet.json

# --- AMITY testnet rail (fail-closed scaffold) ---
# The rail reads ../amity/.env and ../amity/deployments/amity-testnet.json
# first (relative to web/); each of these overrides the corresponding field,
# which is why they are only needed when the file-based config is absent or
# should be overridden for a local experiment.
# AMITY_TESTNET_MANIFEST_PATH=/absolute/path/to/amity/deployments/amity-testnet.json
# Must stay "testnet" for the scaffold to report itself configured.
# AMITY_NETWORK=testnet
# 64-hex asset id of the minted AMITY test asset.
# AMITY_ASSET_ID=<64 hex characters>
# Display names; each has a default ("AMITY Test Asset", "AMITY").
# AMITY_ASSET_NAME=AMITY Test Asset
# AMITY_UNIT_NAME=AMITY
# Universe host of the asset, http(s) URL.
# AMITY_UNIVERSE_URL=https://...
# litd/tapd gRPC endpoints as host:port; defaults 127.0.0.1:8443 and 127.0.0.1:10029.
# LITD_RPC_HOST=127.0.0.1:8443
# TAPD_RPC_HOST=127.0.0.1:10029
# Operator credential files the /ops console reports on (paths, not contents).
# LITD_TLS_CERT_PATH=/absolute/path/to/litd-tls.cert
# LITD_MACAROON_PATH=/absolute/path/to/litd.macaroon
# TAPD_TLS_CERT_PATH=/absolute/path/to/tapd-tls.cert
# TAPD_MACAROON_PATH=/absolute/path/to/tapd.macaroon

# --- Economy test controls (/testnet console, faucet, credits, reset) ---
# Default: enabled outside production builds, disabled in production.
# ECONOMY_TEST_MODE=1

# --- Nostr social layer (consumed by the separately developed Nostr client) ---
# Comma separated wss:// relay URLs. Empty = social layer stays local.
# NOSTR_RELAYS=wss://relay.example.com,wss://relay2.example.com
# Publisher identity for economy events; leave unset for user-signed events.
# NOSTR_PUBLISHER_NPUB=npub1...
# Domain used for NIP-05 identifiers served by this site.
# NOSTR_NIP05_DOMAIN=example.org
# NIP-05 name → pubkey pairs served at /.well-known/nostr.json, as
# "name=hexpubkey,name2=hexpubkey2".
# NOSTR_NIP05_NAMES=alice=<64 hex pubkey>,bob=<64 hex pubkey>
# Root key (npub or hex) whose kind 31990/30017 events populate the /store directory.
# Usually the pubkey of the mobile node's LUCIFER_SECRET (mobile-node/).
# NOSTR_STORE_ROOT_NPUB=npub1...

# --- Wallet download page ---
# Port printed in the "serve this bundle locally" instructions for the offline
# wallet bundle. Default 8787; the launcher itself reads it from its own
# environment when a reader runs those instructions.
# OMEGA_WALLET_PORT=8787
