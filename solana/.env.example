# Copy to .env and fill locally. Never commit a secret key file or this populated file.
# Generate and fund a NEW Solana Devnet-only signer. Do not use a mainnet wallet.
SOLANA_DEPLOYER_KEYPAIR_PATH=
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Optional; derived automatically from the RPC URL when blank.
SOLANA_DEVNET_WS_URL=

# Public recipient of the one-time, fixed tTWC supply. This may be a wallet,
# multisig, or PDA address; it must be controlled outside this repository.
TWC_TREASURY_ADDRESS=

# Publish a final, immutable/content-addressed metadata JSON document first.
# The deployer downloads it and verifies its SHA-256 before creating metadata.
TWC_METADATA_URI=
TWC_METADATA_SHA256=

# Whole-token quantity only. The devnet pilot uses nine decimals and mints once.
TWC_INITIAL_SUPPLY=1000000000
