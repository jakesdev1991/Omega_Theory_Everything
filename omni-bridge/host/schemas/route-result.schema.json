{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-bridge.local/schemas/route-result.schema.json",
  "title": "OmniBridgeRouteResult",
  "description": "Outcome envelope returned from the control boundary, carrying provenance and verification evidence.",
  "type": "object",
  "required": ["trace_id", "status", "route", "verification"],
  "additionalProperties": false,
  "properties": {
    "trace_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["EXECUTED", "REJECTED", "ESCALATED", "ABSTAINED", "FAILED"]
    },
    "route": { "type": "string", "enum": ["hermes", "lucifer", "none"] },
    "sandbox_tier": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3", "T4", "T5"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier1_pass": { "type": "boolean" },
        "tier2_pass": { "type": "boolean" },
        "audit_hash": { "type": "string" }
      },
      "required": ["tier1_pass"]
    },
    "outcome": { "type": "string" },
    "audit_record": {
      "type": "object",
      "additionalProperties": true
    }
  }
}