{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-bridge.local/schemas/route-request.schema.json",
  "title": "OmniBridgeRouteRequest",
  "description": "Normalized task dispatch payload entering the Omni-Bridge control boundary. No LLM output may bypass schema validation to reach execution.",
  "type": "object",
  "required": ["trace_id", "payload", "security_label", "proposed_tools"],
  "additionalProperties": false,
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Correlation id spanning input -> outcome telemetry.",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072,
      "description": "Normalized task text. Bounded to prevent resource exhaustion."
    },
    "security_label": { "$ref": "security-label.schema.json" },
    "proposed_tools": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "tool-call.schema.json" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_usd": { "type": "number", "minimum": 0 },
        "max_latency_ms": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "preferred_route": {
      "type": "string",
      "enum": ["hermes", "lucifer", "auto"],
      "default": "auto"
    }
  }
}