# Copy this file to .env. Never commit the populated file.
# Use a newly created Sepolia-only wallet with faucet ETH; never use a mainnet key.
DEPLOYER_PRIVATE_KEY=

# An HTTPS Sepolia RPC endpoint. The Hardhat config has a public read-only fallback,
# but set a provider you control for a deployment.
SEPOLIA_RPC_URL=

# Public addresses only. A Safe/multisig is recommended even for a pilot when available.
TREASURY_ADDRESS=
GUARDIAN_ADDRESS=

# Optional explorer verification key.
ETHERSCAN_API_KEY=

# Optional testnet pilot parameters. Values below are deliberately valueless defaults.
OMEGA_INITIAL_SUPPLY=1000000000
CLAIM_THRESHOLD_TOKENS=1
# CLAIM_START_UNIX=1770000000
# CLAIM_END_UNIX=1777776000
TIMELOCK_DELAY_SECONDS=86400
VOTING_DELAY_BLOCKS=1
VOTING_PERIOD_BLOCKS=7200
PROPOSAL_THRESHOLD_TOKENS=1000
QUORUM_PERCENT=4
