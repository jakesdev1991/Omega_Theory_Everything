{
  "name": "@omega/evm-testnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sepolia-only, valueless $OMEGA governance and novel-gate pilot contracts.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rimraf artifacts cache coverage typechain-types types",
    "compile": "hardhat compile",
    "size": "node scripts/check-contract-size.js",
    "test": "hardhat test",
    "test:fixture": "hardhat run scripts/run-fixture-harness.js",
    "check": "npm run compile && npm run size && npm test",
    "preflight:sepolia": "hardhat run scripts/preflight-sepolia.js --network sepolia",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.js --network sepolia",
    "activate:pokw": "hardhat run scripts/activate-pokw-minter.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify-sepolia.js --network sepolia",
    "preflight:rehearsal": "node scripts/rehearsal-preflight.js",
    "rehearsal:pokw": "node scripts/rehearsal-pokw-activation.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "dotenv": "16.6.1",
    "hardhat": "3.21.1",
    "rimraf": "6.0.1",
    "solc": "0.8.26"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
